[Unit]
Description=Rigel OS: provision on first boot
After=local-fs.target
# Only run once per install
ConditionPathExists=!/etc/rigel-os/rigel-os-provisioned

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /usr/libexec/rigel-os-provision.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
