[Unit]
Description=Rigel-OS First Boot Optimization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/rigel-os-optimization.sh
RemainAfterExit=yes
# Add Bazzite's "never give up" logic:
Restart=on-failure
RestartSec=60
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

